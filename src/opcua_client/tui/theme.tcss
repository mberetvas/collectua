Screen {
    background: #11131a;
    color: #d7dce2;
}

Header {
    background: #1b2333;
    color: #86e1fc;
}

Footer {
    background: #1b2333;
    color: #9ece6a;
}

#connection-status {
    height: 3;
    border: round #7dcfff;
    margin: 0 1;
    padding: 0 1;
    background: #161925;
}

#main-grid {
    height: 1fr;
    margin: 0 1 1 1;
}

#left-column {
    width: 40%;
    height: 1fr;
}

#right-column {
    width: 60%;
    height: 1fr;
}

#node-tree,
#config-panel,
#alarm-table,
#log-stream {
    border: round #3b4261;
    background: #161925;
    padding: 0 1;
    margin-bottom: 1;
}

#node-tree {
    height: 1fr;
    border-title-color: #7dcfff;
}

#config-panel {
    height: 12;
    border-title-color: #9ece6a;
}

#alarm-table {
    height: 1fr;
    border-title-color: #f7768e;
}

#log-stream {
    height: 12;
    border-title-color: #e0af68;
}

.panel-title {
    color: #e0af68;
    text-style: bold;
    height: 1;
    margin: 0 0 0 1;
}

#help-modal {
    width: 70;
    height: 18;
    border: thick #7dcfff;
    background: #161925;
    color: #d7dce2;
    padding: 1 2;
    content-align: center middle;
}

/* ── Tabbed alarm panel ──────────────────────────────────── */

#tabbed-panel {
    height: 1fr;
    border: round #3b4261;
    background: #161925;
    padding: 0;
    margin-bottom: 1;
}

/* Override shared border/margin for alarm-table inside the tab */
#alarm-table {
    border: none;
    margin-bottom: 0;
    padding: 0 1;
}

/* Node info panel inside the tab */
#node-info-content {
    height: 1fr;
    padding: 1 2;
    background: #161925;
    color: #d7dce2;
    border: none;
    margin-bottom: 0;
}

/* Tab bar theming */
#tabbed-panel Tabs {
    background: #1b2333;
    border-bottom: solid #3b4261;
}

#tabbed-panel Tab {
    color: #9ece6a;
}

#tabbed-panel Tab.-active {
    color: #86e1fc;
    text-style: bold;
}

#tabbed-panel ContentSwitcher {
    height: 1fr;
}

#tab-alarms,
#tab-node-info {
    height: 1fr;
    padding: 0;
}
