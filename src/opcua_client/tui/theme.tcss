Screen {
    background: #050b05;
    color: #8aff80;
}

Header {
    background: #081108;
    color: #8aff80;
}

Footer {
    background: #081108;
    color: #6ee768;
}

#connection-status {
    height: 3;
    border: round #2ca34a;
    margin: 0 1;
    padding: 0 1;
    background: #071207;
}

#main-grid {
    height: 100%;
    margin: 0 1 1 1;
}

#left-column {
    width: 40%;
    height: 100%;
}

#right-column {
    width: 60%;
    height: 100%;
}

#node-tree,
#config-panel,
#alarm-table {
    border: round #2a7d3e;
    background: #071207;
    padding: 0 1;
    margin-bottom: 1;
}

#node-tree {
    height: 1fr;
    border-title-color: #8aff80;
}

#config-panel {
    height: 12;
    border-title-color: #6ee768;
}

#alarm-table {
    height: 1fr;
    border-title-color: #ffbf4d;
}

#log-actions {
    height: 3;
    align: left middle;
    padding: 0 1;
    background: #071207;
    border: round #2a7d3e;
    border-bottom: none;
}

#log-actions Button {
    min-width: 14;
    margin-right: 1;
    background: #081108;
    color: #8aff80;
    border: tall #2a7d3e;
}

#log-actions #btn-copy-errors {
    color: #ff5f5f;
    border: tall #ff5f5f;
}

#log-actions #btn-copy-warnings {
    color: #ffbf4d;
    border: tall #ffbf4d;
}

#node-search {
    border: round #2a7d3e;
    background: #071207;
    margin-bottom: 1;
    color: #8aff80;
}

#node-search:focus {
    border: round #6ee768;
}

#node-search > .input--placeholder {
    color: #2a7d3e;
}

.panel-title {
    color: #ffbf4d;
    text-style: bold;
    height: 1;
    margin: 0 0 0 1;
}

#help-modal {
    width: 70;
    height: 18;
    border: thick #2ca34a;
    background: #071207;
    color: #8aff80;
    padding: 1 2;
    content-align: center middle;
}

#splash-modal {
    width: 100%;
    height: 100%;
    border: none;
    background: #050b05;
    color: #8aff80;
    content-align: center middle;
}

/* ── Tabbed alarm panel ──────────────────────────────────── */

#tabbed-panel {
    height: 1fr;
    border: round #2a7d3e;
    background: #071207;
    padding: 0;
    margin-bottom: 1;
}

/* Override shared border/margin for alarm-table inside the tab */
#alarm-table {
    border: none;
    margin-bottom: 0;
    padding: 0 1;
}

/* Node info panel inside the tab */
#node-info-content {
    height: 1fr;
    padding: 1 2;
    background: #071207;
    color: #8aff80;
    border: none;
    margin-bottom: 0;
}

#node-info-details {
    height: 1fr;
}

#node-info-actions {
    height: auto;
    margin-top: 1;
}

#copy-node-id-btn {
    width: auto;
    min-width: 20;
}

/* Tab bar theming */
#tabbed-panel Tabs {
    background: #081108;
    border-bottom: solid #2a7d3e;
}

#tabbed-panel Tab {
    color: #6ee768;
}

#tabbed-panel Tab.-active {
    color: #ffbf4d;
    text-style: bold;
}

#tabbed-panel ContentSwitcher {
    height: 1fr;
}

#tab-alarms,
#tab-node-info,
#tab-logs {
    height: 1fr;
    padding: 0;
}

#tab-logs #log-panel {
    height: 1fr;
    margin-bottom: 0;
}

#tab-logs #log-stream {
    height: 1fr;
    border: round #2a7d3e;
    background: #071207;
    padding: 0 1;
}
